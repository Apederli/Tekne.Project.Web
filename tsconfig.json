{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    /* Dahili alias'lar. `baseUrl` bilinçli olarak yok: yolu olmayan bir import
       (`models/user` gibi) node_modules yerine buraya düşmesin diye. `@ui/*`
       girdilerini Spartan CLI ekliyor (adı `components.json` içindeki
       `importAlias`'tan gelir) — bileşen eklendikçe listeye yenisi yazılır. */
    "paths": {
      "@models": ["./src/app/core/models/index.ts"],
      "@models/*": ["./src/app/core/models/*"],
      "@enums": ["./src/app/core/enums/index.ts"],
      "@enums/*": ["./src/app/core/enums/*"],
      "@services": ["./src/app/core/services/index.ts"],
      "@services/*": ["./src/app/core/services/*"],
      "@interceptors/*": ["./src/app/core/interceptors/*"],
      "@ui/button": ["./src/app/shared/ui/button/src/index.ts"],
      "@ui/utils": ["./src/app/shared/ui/utils/src/index.ts"],
      "@ui/card": ["./src/app/shared/ui/card/src/index.ts"],
      "@ui/accordion": ["./src/app/shared/ui/accordion/src/index.ts"],
      "@ui/breadcrumb": ["./src/app/shared/ui/breadcrumb/src/index.ts"],
      "@ui/dialog": ["./src/app/shared/ui/dialog/src/index.ts"],
      "@ui/sonner": ["./src/app/shared/ui/sonner/src/index.ts"],
      "@ui/date-picker": ["./src/app/shared/ui/date-picker/src/index.ts"],
      "@ui/calendar": ["./src/app/shared/ui/calendar/src/index.ts"],
      "@ui/select": ["./src/app/shared/ui/select/src/index.ts"],
      "@ui/popover": ["./src/app/shared/ui/popover/src/index.ts"],
      "@ui/input-group": ["./src/app/shared/ui/input-group/src/index.ts"],
      "@ui/input": ["./src/app/shared/ui/input/src/index.ts"],
      "@ui/textarea": ["./src/app/shared/ui/textarea/src/index.ts"],
      "@ui/table": ["./src/app/shared/ui/table/src/index.ts"],
      "@ui/carousel": ["./src/app/shared/ui/carousel/src/index.ts"],
      "@ui/sheet": ["./src/app/shared/ui/sheet/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
