/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    /* Dahili alias'lar. `baseUrl` bilinçli olarak yok: yolu olmayan bir import
       (`models/user` gibi) node_modules yerine buraya düşmesin diye — `@` önekli
       girdiler tekil ve açık kalıyor. Yollar bu dosyaya göre çözülür, extends
       eden tsconfig'ler olduğu gibi devralır. */
    "paths": {
      "@models/*": ["./src/app/core/models/*"],
      "@enums/*": ["./src/app/core/enums/*"],
      "@services/*": ["./src/app/core/services/*"],
      "@interceptors/*": ["./src/app/core/interceptors/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
